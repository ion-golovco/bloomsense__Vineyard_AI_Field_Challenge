# Optional: replace the built-in fictional scene with an EPSG:32635 scene JSON.
# Set this in the shell running the Python service or export command.
# MARCAJ_SCENE_PATH=/absolute/path/to/scene.json
# Optional: folder holding the unzipped organizer package (default: data/raw/marcaj).
# MARCAJ_DATA_DIR=/absolute/path/to/marcaj
